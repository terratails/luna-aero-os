{
  "buildCommand": "node generate-tracklist.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/musics/(.*)",
      "headers": [
        { "key": "Accept-Ranges",  "value": "bytes" },
        { "key": "Cache-Control",  "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/musics/(.*)\\.mp3",
      "headers": [{ "key": "Content-Type", "value": "audio/mpeg" }]
    },
    {
      "source": "/musics/(.*)\\.ogg",
      "headers": [{ "key": "Content-Type", "value": "audio/ogg" }]
    },
    {
      "source": "/musics/(.*)\\.wav",
      "headers": [{ "key": "Content-Type", "value": "audio/wav" }]
    },
    {
      "source": "/musics/(.*)\\.flac",
      "headers": [{ "key": "Content-Type", "value": "audio/flac" }]
    },
    {
      "source": "/musics/(.*)\\.m4a",
      "headers": [{ "key": "Content-Type", "value": "audio/mp4" }]
    },
    {
      "source": "/musics/(.*)\\.aac",
      "headers": [{ "key": "Content-Type", "value": "audio/aac" }]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" }
      ]
    }
  ]
}
